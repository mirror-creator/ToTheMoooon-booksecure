NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key-run-node-src-generate-key.js
OTP_PEPPER=replace-with-random-otp-pepper
MERCHANT_ADMIN_EMAIL=admin@store.com
MERCHANT_ADMIN_PASSWORD=AdminPass123!
# 若不設定 SMTP，系統會用開發模式輸出信件 JSON 到 console 與 data/email-outbox.json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BookSecure <no-reply@booksecure.local>"
